generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String     @id @default(cuid())
  name       String
  email      String
  password   String
  image      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  chats      Chat[]
  messages   Messages[]
  joinedroom Room[]
}

model Room {
  slug      String     @unique
  adminId   String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  id        Int        @id @default(autoincrement())
  chats     Chat[]
  messages  Messages[]
  admin     User       @relation(fields: [adminId], references: [id])
}

model Chat {
  userId  String
  message String
  id      Int    @id @default(autoincrement())
  roomId  Int
  room    Room   @relation(fields: [roomId], references: [id])
  user    User   @relation(fields: [userId], references: [id])
}

model Messages {
  id        Int      @id @default(autoincrement())
  userId    String
  content   String
  roomId    Int
  createdAt DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}
